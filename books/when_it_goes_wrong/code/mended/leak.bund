//
// The day's dues, with a word of warning before a large cargo.
//
//   bund2 leak.bund
//
:due  { 3 * } register
:fee  { 20 + } register
:dues { due fee } register

// line ( name due -- )          print one line of the ledger
:line { swap "{name}: {due} pennies" format println } register

// warned ( units -- units )     say so, if the cargo is over 30 units
:warned {
  dup 30 <
  { "  a large cargo follows" println } if
} register

// entry ( name units -- )
:entry { warned dues dup +. line } register

0 .
"Marta"  40 entry
"Gull"   12 entry
"Osprey" 25 entry
take "Total: {total} pennies" format println
