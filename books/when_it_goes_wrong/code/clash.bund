//
// The day's dues, with a ruled line above the total.
//
//   bund2 clash.bund
//
:due  { 3 * } register
:fee  { 20 + } register
:dues { due fee } register

// line ( name due -- )          print one line of the ledger
:line { swap "{name}: {due} pennies" format println } register

// entry ( name units -- )
:entry { dues dup +. line } register

// line ( -- )                   rule a line across the page
:line { "-" 24 * println } register

0 .
"Marta"  40 entry
"Gull"   12 entry
"Osprey" 25 entry
line
take "Total: {total} pennies" format println
