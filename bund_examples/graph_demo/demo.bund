//
// Every graph word: the reference's seven — `graph!`, `graph`, `graph.`,
// `graph.path`, `graph.paths`, `graph.allpath`, `graph.transitiveclosure` —
// and the twelve Bund2 adds (D192, RFC-0012), then each word's `.` form,
// which holds the graph on the workbench, a graph kept in a file and
// charted with `io.graph`, and last what the words refuse, and the
// answers Bund2 gives where the reference crashes (D193, F219). Run it:
//
//   bund2 demo.bund
//
// A graph is a MAP of `nodes` and `edges` that `graph!` builds from two
// lists, edges first. Node names are Title-cased, so `:fetch` answers as
// `Fetch`. Every answer is in the order of the `nodes` list, so the output
// is the same on every run.
//

//
// 0. Making a graph. `graph!` builds one from two lists. `graph` takes a
//    MAP made any other way, fills in what is missing and checks the rest;
//    `graph.` does the same on the workbench. `graph!` never fails: what is
//    not a list it leaves where it was, and builds an empty graph instead.
//
"-- making a graph" println
"graph! from two lists:     " print [ [ :a :b 2.0 ] ] [ :a :b ] graph! println
"graph on a bare dict:      " print dict graph println
"graph on a dict built by hand: " print
dict :nodes [ :A :B ] set :edges [ [ :A :B 1.0 ] ] set graph println
"graph. on the workbench:   " print dict . graph. take println
"graph! on something else:  " print "rubbish" graph! println
"  ... and it left behind:  " print println
?try
  :try    { dict :nodes 1 set graph println } set
  :except { "graph refuses bad nodes: " print :context get println } set
!
"" println

//
// 1. Build tasks. An edge [ a b ] says a comes before b. `docs` depends on
//    nothing and nothing depends on it.
//
:tasks
[
  [ :fetch :configure ] [ :configure :compile ]
  [ :compile :link ]    [ :compile :test ]
  [ :link :package ]    [ :test :package ]
]
[ :fetch :configure :compile :link :test :package :docs ]
graph! var

"-- build tasks" println
"an order to run them in:   " print :tasks var? graph.toposort println
"what a change to compile reaches: " print :compile :tasks var? graph.reachable println
"breadth first from fetch:  " print :fetch :tasks var? graph.bfs println
"depth first from fetch:    " print :fetch :tasks var? graph.dfs println
"what compile feeds:        " print :compile :tasks var? graph.neighbors println
"edges in and out of package: " print :package :tasks var? graph.degree println
"groups of related tasks:   " print :tasks var? graph.components println
"a cycle, if there is one:  " print :tasks var? graph.cycle println

//
// The same tasks with a mistake: packaging is made a step before
// configuring, which closes a loop. There is no order now, so
// `graph.toposort` fails, and `?try` catches it.
//
:broken
[
  [ :fetch :configure ] [ :configure :compile ]
  [ :compile :link ]    [ :compile :test ]
  [ :link :package ]    [ :test :package ]
  [ :package :configure ]
]
[ :fetch :configure :compile :link :test :package :docs ]
graph! var

"" println
"-- the same tasks, with package before configure" println
"a cycle:                   " print :broken var? graph.cycle println
"tasks that wait on each other: " print :broken var? graph.scc println
?try
  :try    { :broken var? graph.toposort println } set
  :except { "no order: " print :context get println } set
!

//
// 2. Roads between five towns, each weighed in kilometres. The graph is
//    directed, so a two-way road is two edges; `graph.mst` reads every edge
//    both ways and keeps the lightest set that joins every town.
//
:roads
[
  [ :ashby :brook 7.0 ]  [ :brook :ashby 7.0 ]
  [ :ashby :cliff 9.0 ]  [ :cliff :ashby 9.0 ]
  [ :brook :cliff 3.0 ]  [ :cliff :brook 3.0 ]
  [ :brook :dale 12.0 ]  [ :dale :brook 12.0 ]
  [ :cliff :dale 4.0 ]   [ :dale :cliff 4.0 ]
  [ :dale :elm 6.0 ]     [ :elm :dale 6.0 ]
]
[ :ashby :brook :cliff :dale :elm ]
graph! var

"" println
"-- roads" println
"the least road that joins every town: " println :roads var? graph.mst println
// `graph.paths` is the reference's word and looks its start up as given,
// not Title-cased as every other name is: `:ashby` would be unknown.
"from Ashby, by Dijkstra (the reference's word): " println "Ashby" :roads var? graph.paths println
"from Ashby, by Bellman-Ford: " println :ashby :roads var? graph.bellmanford println
// `graph.path` is the reference's word too, and looks both towns up as
// given: the end goes deepest, the start above it.
"the shortest way from Ashby to Elm: " print "Elm" "Ashby" :roads var? graph.path println
?try
  :try    { :elm :ashby :roads var? graph.path println } set
  :except { "lower case is unknown to graph.path: " print :context get println } set
!

//
// One-way ferries between three islands. `graph.allpath` answers every
// pair's shortest distance, each island to itself included, and
// `graph.transitiveclosure` every pair a ferry trip connects.
//
:ferries
[ [ :north :east 2.0 ] [ :east :south 3.0 ] [ :north :south 9.0 ] ]
[ :north :east :south ]
graph! var
"every pair's distance by ferry: " println :ferries var? graph.allpath println
"every pair a ferry trip connects: " println :ferries var? graph.transitiveclosure println

//
// A toll road that pays you to take it is a negative weight, which
// Dijkstra cannot take and Bellman-Ford can. Two of them in a loop would
// pay without end, and that is an error naming a town on the loop.
//
"with a rebate of 2 on the road from Cliff to Brook: " println
:ashby
[ [ :ashby :brook 7.0 ] [ :ashby :cliff 4.0 ] [ :cliff :brook -2.0 ] ]
[ :ashby :brook :cliff ]
graph! graph.bellmanford println
?try
  :try {
    :ashby
    [ [ :ashby :brook 7.0 ] [ :brook :cliff -2.0 ] [ :cliff :brook 1.0 ] ]
    [ :ashby :brook :cliff ]
    graph! graph.bellmanford println
  } set
  :except { "a loop that pays: " print :context get println } set
!

//
// 3. Water mains, each weighed by what it carries a second. How much can
//    reach the town from the reservoir, and through which mains?
//
"" println
"-- water mains" println
:town :reservoir
[
  [ :reservoir :north 10.0 ] [ :reservoir :south 5.0 ]
  [ :north :south 15.0 ]     [ :north :town 4.0 ]
  [ :south :town 10.0 ]
]
[ :reservoir :north :south :town ]
graph! graph.maxflow println

//
// The flow is exact (D193): a main of 5 beside two of ten thousand
// billion still carries its 5, and the answer is 10000000000005.0.
//
"a small main beside two huge ones: " println
:town :reservoir
[ [ :reservoir :dam 1.0e13 ] [ :dam :town 1.0e13 ] [ :reservoir :town 5.0 ] ]
[ :reservoir :dam :town ]
graph! graph.maxflow println

//
// 4. Every word on the workbench. Its `.` form takes the graph from the
//    workbench rather than the stack, and leaves the answer there; any
//    node goes on the stack as before. `take` brings the answer back.
//
"" println
"-- the same questions, the graph on the workbench" println
"graph.toposort.     " print :tasks var? . graph.toposort. take println
"graph.reachable.    " print :tasks var? . :compile graph.reachable. take println
"graph.bfs.          " print :tasks var? . :fetch graph.bfs. take println
"graph.dfs.          " print :tasks var? . :fetch graph.dfs. take println
"graph.neighbors.    " print :tasks var? . :compile graph.neighbors. take println
"graph.degree.       " print :tasks var? . :package graph.degree. take println
"graph.components.   " print :tasks var? . graph.components. take println
"graph.scc.          " print :broken var? . graph.scc. take println
"graph.cycle.        " print :broken var? . graph.cycle. take println
"graph.mst.          " print :roads var? . graph.mst. take println
"graph.bellmanford.  " print :roads var? . :ashby graph.bellmanford. take println
"graph.paths.        " print :roads var? . "Ashby" graph.paths. take println
"graph.path.         " print :roads var? . "Elm" "Ashby" graph.path. take println
"graph.allpath.      " print :ferries var? . graph.allpath. take println
"graph.transitiveclosure. " print :ferries var? . graph.transitiveclosure. take println
"graph.maxflow.      " print
[
  [ :reservoir :north 10.0 ] [ :reservoir :south 5.0 ]
  [ :north :south 15.0 ]     [ :north :town 4.0 ]
  [ :south :town 10.0 ]
]
[ :reservoir :north :south :town ]
graph! . :town :reservoir graph.maxflow. take println

//
// 5. A graph outside the program. A graph is an ordinary MAP, so any word
//    that carries a value carries a graph. `encode.base64` turns a value
//    into Bund's binary form and that into one line of text; `file.write`
//    keeps the line, `io.textfile` reads the file back as a list of lines,
//    and `decode.base64` turns the line into the same MAP. `graph` checks
//    that what came back is a graph before anything asks it a question.
//
"" println
"-- the roads, kept in a file and read back" println
:roads var? encode.base64 "roads.graph" file.write
:stored "roads.graph" io.textfile car decode.base64 graph var
// `==` does not compare MAPs, so compare what each answers.
"the nodes that came back: " print :stored var? :nodes get println
"the least roads, before and after: " print
:roads var? graph.mst :weight get :stored var? graph.mst :weight get == println
"the shortest way from Ashby to Elm, asked of it: " print "Elm" "Ashby" :stored var? graph.path println

//
// `io.graph` is not a graph word at all: it draws a list of FLOATs as a
// text chart. Here it draws the distance from Ashby to each town, in the
// order of the `nodes` list, taken from `graph.bellmanford`'s rows.
//
"the distance from Ashby to each town, charted by io.graph:" println
:ashby :stored var? graph.bellmanford { :path get } map io.graph println
"and io.graph. takes its list from the workbench:" println
:ashby :stored var? graph.bellmanford { :path get } map . io.graph. println

//
// 6. What the words will not take, and where the reference crashes.
//
//    `graph.path` reads its graph its own way: it drops an edge to itself
//    and an edge that weighs less than 1 (F101). A town only such an edge
//    reaches, or no edge at all, is one it cannot route to. The reference
//    crashes there; Bund2 answers `found=false` (F219, D193). `graph.paths`
//    keeps the light lane, so it reaches Farm and not Mill.
//
"" println
"-- what the words refuse, and where the reference crashes" println
:lanes
[ [ :ashby :brook 7.0 ] [ :ashby :farm 0.5 ] [ :brook :brook 1.0 ] ]
[ :ashby :brook :farm :mill ]
graph! var
"from Ashby to Farm, down a lane of half a km: " print "Farm" "Ashby" :lanes var? graph.path println
"from Ashby to Mill, which no road reaches:     " print "Mill" "Ashby" :lanes var? graph.path println
"from Ashby, by graph.paths: " println "Ashby" :lanes var? graph.paths println

//
// A weight must be a finite FLOAT. Bund makes the two that are not:
// `-1.0 math.sqrt` is NaN, and `1.0e200 1.0e200 *` overflows to inf.
// Every word Bund2 adds refuses either, naming the edge (D193). The
// reference's `graph.paths` takes them, as the reference does, and its
// distance comes out NaN.
//
:nan -1.0 math.sqrt var
:inf 1.0e200 1.0e200 * var
?try
  :try    { :ashby :nan var? [ :ashby :brook ] ++ list push [ :ashby :brook ] graph! graph.bfs println } set
  :except { "a weight of NaN:    " print :context get println } set
!
?try
  :try    { :inf var? [ :ashby :brook ] ++ list push [ :ashby :brook ] graph! graph.mst println } set
  :except { "a weight of inf:    " print :context get println } set
!
"graph.paths takes NaN: " print
"Ashby" :nan var? [ :ashby :brook ] ++ list push [ :ashby :brook ] graph! graph.paths println

//
// A refusal names the word and the type it was given.
//
?try
  :try    { :ashby [ [ :ashby :brook 7 ] ] [ :ashby :brook ] graph! graph.bfs println } set
  :except { "a weight of 7, not 7.0: " print :context get println } set
!
?try
  :try    { :ashby [ :ashby ] [ :ashby :brook ] graph! graph.bfs println } set
  :except { "an edge that is a name: " print :context get println } set
!
?try
  :try    { 7 :lanes var? graph.bfs println } set
  :except { "a start that is a number: " print :context get println } set
!
?try
  :try    { :zed :lanes var? graph.bfs println } set
  :except { "a town not in the graph: " print :context get println } set
!
?try
  :try    { :brook :ashby [ [ :ashby :brook -1.0 ] ] [ :ashby :brook ] graph! graph.maxflow println } set
  :except { "a main that carries -1: " print :context get println } set
!
