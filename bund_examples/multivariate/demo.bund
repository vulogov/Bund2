6.4,2.8,5.6,2.2,virginica
6.3,2.8,5.1,1.5,virginica
6.1,2.6,5.6,1.4,virginica
7.7,3.0,6.1,2.3,virginica
6.3,3.4,5.6,2.4,virginica
6.4,3.1,5.5,1.8,virginica
6.0,3.0,4.8,1.8,virginica
6.9,3.1,5.4,2.1,virginica
6.7,3.1,5.6,2.4,virginica
6.9,3.1,5.1,2.3,virginica
5.8,2.7,5.1,1.9,virginica
6.8,3.2,5.9,2.3,virginica
6.7,3.3,5.7,2.5,virginica
6.7,3.0,5.2,2.3,virginica
6.3,2.5,5.0,1.9,virginica
6.5,3.0,5.2,2.0,virginica
6.2,3.4,5.4,2.3,virginica
5.9,3.0,5.1,1.8,virginica
" var
:iris :csv var? dict frame.csv.parse var
:X :iris var? [ "sepal.length" "sepal.width" "petal.length" "petal.width" ] dict frame.matrix var
:species :iris var? "species" frame.column var
"flowers:          " print :iris var? frame.nrow println
"columns:          " print :iris var? frame.names println
"" println

//
// 1. Reducing. `mva.pca` is R's `prcomp`; with `scale` each measurement
//    is first divided by its sd, so that a petal's length, which varies
//    most, does not outweigh the rest by its units. The first component
//    keeps 73% of the variance, the first two 96%. Its loadings, the
//    first column of `rotation`, weigh the petals and the sepal's length
//    together, and the sepal's width against them. A loading's sign is
//    fixed by §S1's rule, its largest element positive.
//
"-- 1. principal components" println
:pca :X var? dict "scale" true set mva.pca var
"sdev:             " print :pca var? "sdev" get roundall println
"proportion:       " print :pca var? "prop" get roundall println
"cumulative:       " print :pca var? "cumprop" get roundall println
"PC1 loadings:     " print :pca var? "rotation" get [ 1.0 0.0 0.0 0.0 ] column println
"" println

//
// 2. Clustering, with no species given. `cluster.dist` takes the
//    Euclidean distance between every pair of flowers; `cluster.hclust`
//    joins the nearest groups by average linkage, as R's `hclust`; and
//    `cluster.cut` cuts the tree into three. A frame of the clusters
//    beside the species, counted by `frame.aggregate`, shows setosa apart
//    and 14 virginica among the versicolor. `cluster.kmeans` is R's
//    Hartigan–Wong, from ten starts drawn by the VM's generator; the
//    best keeps 88% of the total sum of squares between the clusters.
//
"-- 2. clustering" println
:D :X var? dict cluster.dist var
:tree :D var? dict "method" "average" set cluster.hclust var
:cut :tree var? 3 cluster.cut var
:tab [ "species" "cluster" ] list :species var? swap push :cut var? swap push frame.new var
"average linkage, cut at three:" println
:tab var? [ "species" "cluster" ] [ [ "species" "count" ] ] dict frame.aggregate frame.text println
42 rng.seed
:km :X var? 3 dict "nstart" 10 set cluster.kmeans var
"k-means sizes:    " print :km var? "size" get println
"within, total:    " print :km var? "tot.withinss" get round print " " print :km var? "totss" get round println
"between / total:  " print :km var? "totss" get :km var? "betweenss" get / round println
"" println

//
// 3. Testing. Do the species differ in their four means together?
//    `stat.test.manova` is R's one-way `manova` with `summary`'s tests;
//    Pillai's trace is the default, Wilks's Λ is asked for by `test`. The
//    p values are far below anything a FLOAT prints to six places, so
//    the lines below print −log₁₀ p.
//
"-- 3. testing the species" println
:pillai :X var? :species var? dict stat.test.manova var
"Pillai:           " print :pillai var? "statistic" get round print ", F " print :pillai var? "F" get round print " on " print :pillai var? "df1" get print " and " print :pillai var? "df2" get println
"  -log10 p:       " print :pillai var? "p" get math.log10 -1.0 * round println
:wilks :X var? :species var? dict "test" "wilks" set stat.test.manova var
"Wilks:            " print :wilks var? "statistic" get round print ", F " print :wilks var? "F" get round print " on " print :wilks var? "df1" get print " and " print :wilks var? "df2" get println
"  -log10 p:       " print :wilks var? "p" get math.log10 -1.0 * round println
"" println

//
// 4. Classifying. `mva.lda` is MASS's `lda`: two discriminants for three
//    species, the first carrying 99% of the separation, the squares of
//    `svd` over their sum. `mva.lda.predict` classifies the flowers it
//    was fitted on, which overstates how well it would do on new ones:
//    three of 150 are misplaced. Then flower 71, a versicolor, measured
//    again as a new flower: the fit calls it virginica.
//
"-- 4. classifying" println
:fit :X var? :species var? dict mva.lda var
"species:          " print :fit var? "lev" get println
"svd:              " print :fit var? "svd" get roundall println
:s1 :fit var? "svd" get car dup * var
:s2 :fit var? "svd" get cdr car dup * var
"trace:            " print :s1 var? :s2 var? + :s1 var? / round print " " print :s1 var? :s2 var? + :s2 var? / round println
:pred :fit var? :X var? dict mva.lda.predict var
:tab [ "species" "class" ] list :species var? swap push :pred var? "class" get swap push frame.new var
"species against class:" println
:tab var? [ "species" "class" ] [ [ "species" "count" ] ] dict frame.aggregate frame.text println
:new :fit var? [ [ 5.9 3.2 4.8 1.8 ] ] matrix dict mva.lda.predict var
"flower 71:        " print :new var? "class" get println
"posterior:        " print :new var? "posterior" get linalg.t [ 1.0 ] column println
"" println

//
// 5. A density. Petal length has two humps: setosa's short petals near
//    1.5 cm, and the other two species' between 4 and 6. `stat.bw`'s
//    `"nrd0"`, Silverman's rule of thumb and R's default, assumes one
//    hump and smooths over the gap; Sheather and Jones's `"sj"` takes a
//    third as wide a kernel. `stat.density` is R's `density`, here with
//    the SJ bandwidth, evaluated at 13 points from 1 to 7 cm: the trough
//    at 2.5 cm, where no flower is, falls to under 0.001.
//
"-- 5. petal length's density" println
:petal :iris var? "petal.length" frame.column var
"bw nrd0 and sj:   " print :petal var? "nrd0" stat.bw round print " " print :petal var? "sj" stat.bw round println
:den :petal var? dict "bw" "sj" set "from" 1.0 set "to" 7.0 set "n" 13 set stat.density var
"bandwidth, n:     " print :den var? "bw" get round print " " print :den var? "n" get println
"x:                " print :den var? "x" get roundall println
"density:          " print :den var? "y" get roundall println
